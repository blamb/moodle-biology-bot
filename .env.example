# Copy to .env and fill in. .env is gitignored.

# Public URL the LTI tool is reachable on (Moodle uses this URL).
# In dev: the ngrok static domain. In prod: the Railway custom domain.
LTI_TOOL_URL=https://flashcard-rebuilt-junction.ngrok-free.dev

# Local port the Node app listens on (ngrok tunnels the static domain to this).
PORT=3000

# Postgres for the app's own data (students, sessions, progress).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/biology_bot

# Random secret used by ltijs to sign cookies. Generate with: openssl rand -hex 32
LTI_COOKIE_SECRET=change-me-to-a-long-random-string

# Anthropic API key (Brian's during dev; TRU/professor in production).
# Tip: use a key in a dedicated Anthropic Console workspace so this tool's
# usage and spend limits are tracked separately from any other project.
ANTHROPIC_API_KEY=sk-ant-...

# Model selection per AI function. All default to Haiku 4.5 ($1/$5 per 1M) for
# the cheapest run at scale. Override any one with a stronger model — e.g.
# claude-opus-4-8 ($5/$25) or claude-sonnet-4-6 ($3/$15) — if its quality drops.
# Add any new model's pricing to MODEL_PRICES in src/server/costs.ts too.
GEN_MODEL=claude-haiku-4-5      # question generation + coaching feedback
TUTOR_MODEL=claude-haiku-4-5    # Socratic tutor chat
GRADER_MODEL=claude-haiku-4-5   # free-response grading

# Token that gates the operational /admin/* endpoints (cost dashboard, etc).
# These are NOT exposed to teachers or students inside Moodle — admin-only.
# Leave blank to disable the admin endpoints entirely.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=
