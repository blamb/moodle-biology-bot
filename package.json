{
  "name": "moodle-biology-bot",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "LTI 1.3 tool for BIOL 1592/1692 — AI tutor and practice-question generator for Human A&P at TRU",
  "scripts": {
    "ingest:pptx": "python3 scripts/ingest/extract_pptx.py",
    "ingest:terms": "python3 scripts/ingest/extract_xlsx_terms.py",
    "ingest:exam": "python3 scripts/ingest/extract_exam_docx.py",
    "ingest:textbooks": "python3 scripts/ingest/fetch_pressbooks.py",
    "ingest:build": "python3 scripts/ingest/build_units.py",
    "ingest:all": "npm run ingest:pptx && npm run ingest:terms && npm run ingest:exam && npm run ingest:textbooks && npm run ingest:build",
    "db:migrate": "tsx src/server/migrate.ts",
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc -p .",
    "start": "node dist/server/index.js",
    "tunnel": "~/Downloads/ngrok http --domain=flashcard-rebuilt-junction.ngrok-free.dev 3000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.0",
    "dotenv": "^16.4.5",
    "ltijs": "^5.9.9",
    "ltijs-sequelize": "^2.4.4",
    "mysql2": "^3.11.0",
    "pg": "^8.13.0",
    "sequelize": "^6.37.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
