{
  "name": "lti-tutor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LTI 1.3 tool for Moodle: instructor-designed one-on-one AI tutorials (Paski-style) with voice, deep linking, gradebook passback and debriefs",
  "scripts": {
    "db:migrate": "tsx src/server/migrate.ts",
    "dev": "tsx watch src/server/index.ts",
    "build": "rm -rf dist && tsc -p . && cp -r src/server/migrations dist/server/migrations && cp -r src/web dist/web",
    "start": "node dist/server/migrate.js && node dist/server/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.0",
    "dotenv": "^16.4.5",
    "ltijs": "^5.9.9",
    "ltijs-sequelize": "^2.4.4",
    "pg": "^8.13.0",
    "sequelize": "^6.37.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
